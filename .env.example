# Salin file ini jadi ".env" untuk dev lokal, atau set sebagai Environment Variable di Vercel.
# Cara ambil: lihat README bagian "Setup"

SPREADSHEET_ID=1AbCdEfGh123...

# Email service account (dari JSON key Google Cloud)
GOOGLE_SERVICE_ACCOUNT_EMAIL=pilates-app@your-project.iam.gserviceaccount.com

# Private key service account. Simpan persis, termasuk baris BEGIN/END PRIVATE KEY.
# Jangan ubah \n (biarkan sebagai karakter literal backslash-n).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"
